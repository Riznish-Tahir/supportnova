      "rule_id": "RULE-001",
      "category": "Delivery",
      "subcategory": "Delayed Delivery",
      "conditions": [
        "complaint.category == 'Delivery'",
        "complaint.subcategory == 'Delayed Delivery'"
      ],
      "department": "Logistics Support",
      "supporting_department": null,
      "urgency": "Medium",
      "priority": "P2",
      "policy_id": "DEL-POL-04",
      "policy_section": "2.2",
      "escalation_required": false,
      "escalation_level": "No Escalation",
      "required_actions": [
        "Verify delayed delivery against order/account records",
        "Confirm customer identity and order reference",
        "Apply resolution per policy DEL-POL-04"
      ],
      "prohibited_actions": [
        "Promise compensation not covered by policy",
        "Guarantee a resolution timeline not defined in the SLA",
        "Disclose another customer's account information"
      ],
      "compensation_eligible": false,
      "follow_up_required": true,
      "follow_up_type": "Resolution confirmation"
    },
