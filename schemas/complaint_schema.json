{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SupportNova GenAI Complaint Intelligence Output",
  "type": "object",
  "required": [
    "complaint_id", "issue_category", "subcategory", "sentiment", "urgency",
    "priority", "department", "resolution_steps", "escalation_required",
    "response_type", "follow_up_required", "professional_response"
  ],
  "properties": {
    "complaint_id": {"type": "string", "pattern": "^CMP-[0-9A-Za-z]{5,}$"},
    "primary_issue": {"type": "string"},
    "secondary_issue": {"type": ["string", "null"]},
    "issue_category": {
      "type": "string",
      "enum": ["Product Defect", "Billing", "Delivery", "Refund", "Account",
                "Technical Support", "Service Quality", "Warranty", "Privacy",
                "Safety", "Staff Behavior"]
    },
    "subcategory": {"type": "string"},
    "sentiment": {
      "type": "string",
      "enum": ["Positive", "Neutral", "Negative", "Strongly Negative"]
    },
    "urgency": {"type": "string", "enum": ["Low", "Medium", "High", "Critical"]},
    "priority": {"type": "string", "enum": ["P3", "P2", "P1", "P0"]},
    "entities": {
      "type": "object",
      "properties": {
        "product": {"type": ["string", "null"]},
        "order_id": {"type": ["string", "null"]},
        "transaction_id": {"type": ["string", "null"]},
        "amount": {"type": ["string", "null"]},
        "date": {"type": ["string", "null"]}
      }
    },
    "department": {"type": "string"},
    "supporting_department": {"type": ["string", "null"]},
    "policy_id": {"type": ["string", "null"]},
    "policy_section": {"type": ["string", "null"]},
    "resolution_steps": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "escalation_required": {"type": "boolean"},
    "escalation_level": {
      "type": "string",
      "enum": ["No Escalation", "Supervisor Review", "Department Manager",
                "Specialist Team", "Compliance Review", "Critical Management Escalation"]
    },
    "escalation_reason": {"type": ["string", "null"]},
    "response_type": {"type": "string"},
    "professional_response": {"type": "string"},
    "follow_up_required": {"type": "boolean"},
    "follow_up_type": {"type": ["string", "null"]},
    "clarification_questions": {"type": "array", "items": {"type": "string"}},
    "agent_guidance": {"type": "array", "items": {"type": "string"}},
    "missing_information": {"type": "array", "items": {"type": "string"}},
    "prompt_injection_detected": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
